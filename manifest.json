{
  "manifest_version": 3,
  "name": "Dev Toolkit for Odoo",
  "short_name": "Odoo Toolkit",
  "version": "1.6.0",
  "description": "Odoo developer toolkit: debug switcher, barcode simulator, OWL inspector, website inspector, screenshots and recording.",
  "author": {
    "email": "gmostafa1210@gmail.com"
  },
  "homepage_url": "https://mostafa.bd",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Dev Toolkit for Odoo",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabCapture"
  ],
  "optional_host_permissions": [
    "https://claude.ai/*",
    "http://*/*",
    "https://*/*"
  ],
  "devtools_page": "devtools/devtools.html",
  "commands": {
    "toggle-debug": {
      "suggested_key": {
        "default": "Ctrl+Period",
        "mac": "Command+Period"
      },
      "description": "Toggle Odoo debug mode (press twice quickly for assets mode)"
    },
    "full-page-capture": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Capture a full page screenshot"
    },
    "toggle-recording": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Start or stop screen recording"
    }
  }
}